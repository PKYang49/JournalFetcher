<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pokai.weekly-appraisal-requests</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>-m</string>
        <string>weekly.process_appraisal_requests</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/pokai/JournalFetcher</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/pokai/.local/bin:/opt/homebrew/bin:/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/pokai</string>
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Users/pokai/JournalFetcher/output/logs/weekly-appraisal-requests.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/pokai/JournalFetcher/output/logs/weekly-appraisal-requests.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
